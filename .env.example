# Alpaca market data. The radar never sends orders.
ALPACA_KEY_ID=your_key_id_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=sip

# 14:00 Europe/Paris, before the US open. The report studies the last completed US session.
SCAN_TIMEZONE=Europe/Paris
SCAN_HOUR=14
SCAN_MINUTE=0

# Universe
SWING_MIN_PRICE=10
SWING_MIN_DOLLAR_VOLUME=20000000
SWING_MIN_ADR_PCT=4
SWING_MIN_RS=70

# Illustrative Van Tharp ticket printed on each study card. Not an order.
REFERENCE_CAPITAL_USD=100000
REFERENCE_RISK_PCT=0.01
REFERENCE_MAX_POSITION_PCT=0.20

# Optional alerts
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Research scripts still read these. They do not change the radar universe.
MIN_CLOSE_PRICE=5
MAX_CLOSE_PRICE=100
POOL_SIP_MIN_DOLLAR_VOLUME=5000000
POLICY_MONITOR_SEC_USER_AGENT=trading-bot research (personal)
