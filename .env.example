# Alpaca API credentials (Paper Trading)
ALPACA_KEY_ID=your_paper_key_id_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Paper trading base URLs (do not change for paper mode)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Strategy parameters (optional overrides — defaults are set in config.ts)
# Unified pool (#30): 3 slots, first signal that sizes takes a seat. No Core/Satellite quota.
MAX_POSITIONS=3
# Cash-account notional ceiling: qty*entry <= equity*MAX_POSITION_PCT (no leverage).
# 3 × 40% = 120% : en pratique 2 tickets puis un reliquat, le settled cash coupe le 3e.
MAX_POSITION_PCT=0.40
RISK_PER_TRADE_PCT=0.05
# Journal V7: risk_$ at entry ≈ stopDist×qty (fallback equity×RISK_PER_TRADE_PCT) → pnl_r on close
MIN_RISK_REWARD_RATIO=2
ATR_TRAIL_TRIGGER_PCT=0.015
ATR_TRAIL_MULTIPLIER=2
TIME_STOP_MINUTES=45
ATR_STOP_MULTIPLIER=1.5
HARD_STOP_FLOOR_PCT=0.015
SCALE_OUT_TARGET_PCT=0.05
TRAILING_STOP_PCT=0.025
EOD_TIGHT_TRAIL_PCT=0.005
# 0 = circuit breaker profit inactif (le kill-switch drawdown reste).
DAILY_PROFIT_TARGET_PCT=0

# V6 — Daily kill-switch, dynamic exits & volume confirmation
DAILY_DRAWDOWN_LIMIT_DOLLARS=-1500
DAILY_DRAWDOWN_LIMIT_PCT=-0.015
ATR_TP_MULTIPLIER=1.5
ATR_STOP_MULTIPLIER_5M=1.0
SMART_EXIT_MIN_PNL_PCT=0.01
SMART_EXIT_RSI_PERIOD=14
SMART_EXIT_RSI_THRESHOLD=80
VOLUME_EXHAUSTION_MIN_PNL_PCT=0.005
VOLUME_EXHAUSTION_VMA_RATIO=0.5
VOLUME_EXHAUSTION_CONSECUTIVE_BARS=2
VOLUME_EXHAUSTION_TRAIL_PCT=0.002
TIME_DECAY_TP_HALVE_START_HOUR=13
TIME_DECAY_TP_HALVE_END_HOUR=14
TIME_DECAY_TP_HALVE_END_MINUTE=30
TIME_DECAY_AFTERNOON_TRAIL_PCT=0.005
TIME_DECAY_AFTERNOON_MIN_PNL_PCT=0.015
VOLUME_CONFIRMATION_VMA_PERIOD=10

# Unused since #30 (unified 3-slot pool). Kept so an existing .env still loads.
DECAY_TIER1_HOUR=10
DECAY_TIER1_MINUTE=15
DECAY_TIER2_HOUR=11
DECAY_TIER2_MINUTE=0
DECAY_TIER3_HOUR=11
DECAY_TIER3_MINUTE=45

MIN_RELATIVE_VOLUME=2.0
MIN_GAP_UP_PCT=0.02
WATCHLIST_MAX_SIZE=50
RELATIVE_STRENGTH_LOOKBACK_DAYS=20
VOLUME_AVERAGE_DAYS=14
# V7 liquidity (spec §1)
MIN_CLOSE_PRICE=5
MIN_DOLLAR_VOLUME=20000000
MIN_ADR_PCT=4.0
ADR_LOOKBACK_DAYS=14
# Float gate needs an external provider (Polygon/FMP/IEX). Keep false until wired.
FLOAT_FILTER_ENABLED=false
MIN_FLOAT_SHARES=10000000
MAX_FLOAT_SHARES=500000000
# Weinstein Phase 2 (spec §2) — SMA 150/200 + slope over N weeks
SMA_150_PERIOD=150
SMA_200_PERIOD=200
SMA_150_SLOPE_WEEKS=8
# Reversal patterns (§3.A) — soft annotate after Weinstein (no hard reject)
PATTERN_FILTER_ENABLED=true
PATTERN_LOOKBACK_BARS=120
PATTERN_PIVOT_LEFT=3
PATTERN_PIVOT_RIGHT=3
ETEI_BREAKOUT_RVOL=1.5
SPRING_RECLAIM_RVOL=1.5
SPRING_SUPPORT_TOLERANCE_PCT=0.005
PATTERN_RVOL_AVG_DAYS=14
# Continuation patterns (§3.B)
BULL_FLAG_IMPULSE_MIN_PCT=0.08
BULL_FLAG_IMPULSE_MAX_BARS=10
BULL_FLAG_MIN_BARS=3
BULL_FLAG_MAX_BARS=15
BULL_FLAG_VOL_DRY_UP_RATIO=0.60
BULL_FLAG_BREAKOUT_RVOL=1.5
CUP_MIN_BARS=20
CUP_MAX_BARS=65
CUP_MAX_DEPTH_PCT=0.35
HANDLE_MAX_RETRACE_PCT=0.15
HANDLE_MAX_BARS=15
FLAT_BASE_BARS=30
FLAT_BASE_ATR_SHORT=20
FLAT_BASE_ATR_REF=50
FLAT_BASE_ATR_COMPRESSION_RATIO=0.70
# Premarket Satellite — share volume on 1Min bars EST [04:00, 09:30)
PREMARKET_MIN_GAP_UP_PCT=0.04
PREMARKET_MIN_SHARE_VOLUME=300000
PREMARKET_WATCHLIST_MAX_SIZE=10
ATR_PERIOD=14
VOLUME_BREAKOUT_MULTIPLIER=1.5
SIGNAL_BATCH_WINDOW_MS=10000
TRADE_DURING_LUNCH=false
# V7 Core VWAP Pullback — entry window EST [start, end)
ENTRY_WINDOW_START_HOUR=10
ENTRY_WINDOW_START_MINUTE=0
ENTRY_WINDOW_END_HOUR=11
ENTRY_WINDOW_END_MINUTE=30
# |price-vwap|/vwap <= 0.1% (Core). Legacy Satellite tick-up still uses PULLBACK_SUPPORT_PCT=0.2%.
VWAP_PROXIMITY_PCT=0.001
# Green 5m confirmation RVOL (strict >). Legacy breakout arming used 1.2.
MIN_RVOL_FOR_PULLBACK=1.5
PULLBACK_DRY_UP_RATIO=0.70
PULLBACK_IMPULSE_BARS=5
# Legacy Satellite 1m support proximity (0.2%) — not used by Core V7 path
PULLBACK_SUPPORT_PCT=0.002

# Market-data bus (WS producer → strategy consumer)
BUS_MAX_QUEUE=10000
# drop_oldest (default): keep newest bars under lag; drop_newest: preserve older sequence
BUS_DROP_POLICY=drop_oldest

# Offline replay (#11) — fixture playback into the bus (no network)
REPLAY_SLIPPAGE_BPS=0
REPLAY_FILL_DELAY_MS=0
# Documented seed (RNG-free today; reserved for future stochastic models)
REPLAY_SEED=0

# Level 2 / quotes (IEX top-of-book proxy — not full SIP depth)
LEVEL2_ENABLED=false
L2_FAST_TRIGGER=false
L2_TOP_N=5
L2_IMBALANCE_THRESHOLD=0.65

# Morning regime model (#9) — heuristic classifier + VIX vol scaling
# Off by default. Shadow = log prediction without changing risk/RR.
REGIME_MODEL_ENABLED=false
REGIME_MODEL_SHADOW=false
VIX_RISK_HALVE_THRESHOLD=25
CHOPPY_RR=1.5
CHOPPY_SPY_ADR_PCT=1.2
CHOPPY_VIX_MIN=18
# Yahoo chart URL for ^VIX (external; null → UNKNOWN / graceful degrade)
# VIX_YAHOO_URL=https://query1.finance.yahoo.com/v8/finance/chart/%5EVIX?interval=1d&range=5d

# News catalyst / sentiment gate (#21) — Alpaca News + lexicon classifier
# Off by default. When on: exclude symbols without ≥1 BULLISH headline in lookback.
SENTIMENT_FILTER_ENABLED=false
SENTIMENT_LOOKBACK_HOURS=48
SENTIMENT_MAX_HEADLINES=25
SENTIMENT_FETCH_CONCURRENCY=5

# Observabilité — au moins un canal recommandé en production
# Discord : créer un webhook dans les paramètres d'un channel (Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=

# Telegram : créer un bot via @BotFather, récupérer le token + chat_id via getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fichier d'environnement à charger. Laisser vide en dev/prod (défaut: .env).
# `npm test` le pointe sur test/fixtures/test.env pour figer les valeurs par défaut.
# ENV_FILE=.env

# Tag STRAIGHT_RUN (#29) — annotation seule, ne rejette jamais un candidat Core.
# Arme le path Opening Drive sur les titres qui montent sans jamais offrir de repli VWAP.
# Le drawdown est mesuré sur les CLOTURES : le screener exige déjà ADR > 4%, donc
# une mesure high/low dépasserait le plafond de 4% par la seule volatilité normale.
# STRAIGHT_RUN_MIN_REL_RVOL est RELATIF au marché (ratio du titre / ratio de SPY).
# Un seuil absolu ne marche pas : dans le creux de volume de la mi-août, tout le
# marché SPY inclus tourne à ~0.75x, donc un plancher de 1.0 absolu rejetterait
# même WDC (+22% sur 5 séances, 0.13% de drawdown).
STRAIGHT_RUN_MIN_DAYS=5
STRAIGHT_RUN_MAX_DD_PCT=0.04
STRAIGHT_RUN_MIN_REL_RVOL=1.0
STRAIGHT_RUN_RVOL_BASELINE_DAYS=14

# --- Path Opening Drive Satellite (#29) ---------------------------------------
# Deuxième porte d'entrée, réservée aux tickers tagués STRAIGHT_RUN : ces titres
# montent en ligne droite et n'offrent jamais le repli VWAP que Core V7 attend.
# Achète la continuation, donc aucun filtre de repli (VWAP proximity, Fibonacci).
#
# Mode shadow : le signal est journalisé, aucun ordre n'est envoyé au broker.
# À laisser à true jusqu'à validation de l'espérance sur 10-20 séances.
OD_SHADOW=true

# Journal des observations. Volontairement SÉPARÉ de journal.json : le
# FeedbackEngine recalibre les filtres d'entrée live à partir de ce dernier, et
# des entrées théoriques qui n'ont jamais atteint le broker le fausseraient.
OD_SHADOW_PATH=./data/shadow_signals.json

# Horizon d'observation en minutes. Pour chaque setup on enregistre le MFE et le
# MAE (mesurés sur les high/low, donc intrabar : un stop théorique se déclenche
# en cours de bougie, une simulation sur les clôtures annoncerait des gains sur
# des trades en réalité stoppés), et si le stop aurait été touché avant le MFE.
# Les setups rejetés par le seul OD_MAX_EXTENSION_PCT sont observés à l'identique
# avec rejectedBy='max_extension' : un compteur seul ne dit pas si le cap tue des
# winners. Une observation par symbole et par séance, comme en live.
OD_SHADOW_HORIZON_MIN=60

# Fenêtre d'exécution (heure NY). Démarre à 09:45 pour ne jamais disputer
# l'unique slot Satellite à l'ORB, qui occupe 09:30-09:45.
# Le démarrage avant la fin de l'ORB est refusé au boot (fail-fast).
OD_WINDOW_START_HOUR=9
OD_WINDOW_START_MINUTE=45
OD_WINDOW_END_HOUR=10
OD_WINDOW_END_MINUTE=15

# Déclencheur : l'un OU l'autre suffit.
# RVOL 1-min de la bougie d'impulsion, mesuré sur OD_RVOL_BASELINE_BARS barres.
OD_RVOL_1M=2.0
# Pression acheteuse au carnet (bidSize / (bidSize + askSize)), profondeur 1 sur
# IEX. Nécessite LEVEL2_ENABLED=true, sinon seul le RVOL peut armer.
OD_MIN_IMBALANCE=0.65
# Baseline du RVOL 1-min : 20 barres = 20 minutes. Volontairement plus long que
# la baseline 5-min du path Core, qui ne couvrirait ici que 5 minutes de bruit.
OD_RVOL_BASELINE_BARS=20

# Garde anti-chasse : refus si l'entrée est à plus de X% AU-DESSUS DU VWAP de
# séance. La référence est le VWAP et non l'Open : la fenêtre ne s'ouvre que 15
# minutes après l'Open, or sur un vrai drive ce quart d'heure suffit à dépasser
# n'importe quel cap serré — un cap ancré sur l'Open rejetterait donc exactement
# les mouvements que ce path existe pour capter (vérifié sur WDC : extension
# depuis l'Open 0,05%..6,2% selon la séance, contre -0,6%..2,5% depuis le VWAP).
# Ce rejet est évalué en dernier, donc un setup rejeté par ce cap a passé tous
# les autres filtres — c'est ce qui rend l'audit shadow du cap exploitable.
OD_MAX_EXTENSION_PCT=0.015

# Cache EOD — historiques daily ajustés, figés par jour de bourse NY.
# Le premier run du soir fait foi : les suivants relisent le cache au lieu de
# retaper l'API, ce qui garantit une SMA200 identique d'un run à l'autre.
# Purge manuelle si besoin : rm -rf data/eod/YYYY-MM-DD
EOD_CACHE_PATH=./data/eod

# Liveness — heartbeat produit par le bot, consommé par le watchdog (npm run watchdog)
# Les deux process doivent pointer sur le même fichier.
HEARTBEAT_PATH=./data/heartbeat.json
HEARTBEAT_INTERVAL_MS=20000

# Watchdog — process indépendant, aucune clé broker, il alerte mais n'agit jamais
WATCHDOG_POLL_INTERVAL_MS=30000
# Fenêtre de grâce au boot : les deux units systemd démarrent ensemble
WATCHDOG_STARTUP_GRACE_MS=120000
# Doit être strictement supérieur à WATCHDOG_POLL_INTERVAL_MS
WATCHDOG_HEARTBEAT_STALE_MS=120000
# Feed muet alors que le process vit (socket ouverte sans barres)
WATCHDOG_MARKET_DATA_STALE_MS=180000
# Garde-fou grossier : screener 20:00 EST veille + week-ends/fériés tolérés
WATCHDOG_WATCHLIST_MAX_AGE_HOURS=96
# Position encore ouverte après cette heure EST = EOD sweep non exécuté
WATCHDOG_OPEN_POSITION_CHECK_HOUR=16
WATCHDOG_OPEN_POSITION_CHECK_MINUTE=5
# Au-delà, le compte de positions broker est trop vieux pour alerter
WATCHDOG_POSITION_DATA_MAX_AGE_MS=600000
# Digests « tout va bien » (EST) — rendent le silence vérifiable
WATCHDOG_DIGEST_OPEN=09:35
WATCHDOG_DIGEST_CLOSE=16:10
