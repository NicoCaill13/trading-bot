{
  "name": "trading-bot",
  "version": "1.0.0",
  "description": "Quantitative algorithmic trading bot for US equities via Alpaca API",
  "main": "src/index.ts",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "watchdog": "tsx src/watchdog.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc -p tsconfig.scripts.json",
    "screener": "tsx src/screener.ts",
    "premarket-screener": "tsx src/premarket_screener.ts",
    "replay": "tsx src/scripts/replay.ts",
    "test": "ENV_FILE=test/fixtures/test.env tsx --test test/*.test.ts test/patterns/*.test.ts"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^3.1.2",
    "dotenv": "^16.4.5",
    "technicalindicators": "^3.1.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
