# Frozen environment for the test suite — loaded via ENV_FILE by `npm test`.
#
# Deliberately minimal: only the variables `requireEnv` demands are set, so every
# tunable falls back to its code default. Tests therefore assert the documented
# defaults instead of whatever the developer happens to have in their local .env.
#
# Never add a tuning variable here to make a test pass — fix the test or the default.

ALPACA_KEY_ID=test-key-id
ALPACA_SECRET_KEY=test-secret-key
